# Copy to .env.local and fill with your InsForge project values.

# Public — exposed to the browser via NEXT_PUBLIC_*.
# Get the anon key from:  GET /api/metadata/anon-key  (admin API key required).
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Admin — server only. NEVER prefix with NEXT_PUBLIC_.
INSFORGE_API_KEY=